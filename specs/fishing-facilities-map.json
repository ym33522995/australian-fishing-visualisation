{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "City of Moreton Bay council asset records aggregated in fixed EPSG:9473 5 km cells. Fixed study extent; area-based size scale shared by all facility categories.",
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "params": [
    {
      "name": "facilityType",
      "value": "All facilities",
      "bind": {
        "input": "select",
        "options": [
          "All facilities",
          "Ramps",
          "Fish-cleaning stations",
          "Canoe stands",
          "Jetties"
        ],
        "name": "Facility type: "
      }
    },
    {
      "name": "facilitiesZoom",
      "value": 1
    },
    {
      "name": "facilitiesPanX",
      "value": 0
    },
    {
      "name": "facilitiesPanY",
      "value": 0
    }
  ],
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "min((width - 24) / 0.01532032809727991, (height - 24) / 0.016949093550880257) * facilitiesZoom"
    },
    "translate": {
      "expr": "[width/2 - 0.3203897992977683*(min((width - 24) / 0.01532032809727991, (height - 24) / 0.016949093550880257) * facilitiesZoom) + width*facilitiesZoom*facilitiesPanX, height/2 - 0.02856918770488459*(min((width - 24) / 0.01532032809727991, (height - 24) / 0.016949093550880257) * facilitiesZoom) + height*facilitiesZoom*facilitiesPanY]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/geojson/moreton_bay_context.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "clip": true
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.properties.LGA_NAME_2025 === 'Moreton Bay'",
            "value": "#a8bfb7"
          },
          "value": "#c3cfca",
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/geojson/facility_grid.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#9aafb8",
        "strokeWidth": 0.6,
        "strokeDash": [
          2,
          3
        ],
        "opacity": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "name": "facility_cells",
        "url": "data/csv/facility_grid_counts.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "asset_count": "number",
            "total_assets": "number",
            "ramps": "number",
            "fish_cleaning_stations": "number",
            "canoe_stands": "number",
            "jetties": "number",
            "category_total": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.facility_category === facilityType && datum.asset_count > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#7a697d",
        "opacity": 0.65,
        "stroke": "#ffffff",
        "strokeWidth": 0.7,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "asset_count",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              18
            ],
            "range": [
              0,
              600
            ],
            "zero": true,
            "type": "linear",
            "nice": false
          },
          "legend": {
            "title": "Asset records per 5 km cell",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              1,
              5,
              10,
              18
            ],
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "cell_id",
            "type": "nominal",
            "title": "Cell ID"
          },
          {
            "field": "facility_category",
            "type": "nominal",
            "title": "Selected facility category"
          },
          {
            "field": "asset_count",
            "type": "quantitative",
            "title": "Selected category asset records",
            "format": ",.0f"
          },
          {
            "field": "total_assets",
            "type": "quantitative",
            "title": "Total asset records in cell",
            "format": ",.0f"
          },
          {
            "field": "ramps",
            "type": "quantitative",
            "title": "Ramps",
            "format": ",.0f"
          },
          {
            "field": "fish_cleaning_stations",
            "type": "quantitative",
            "title": "Fish-cleaning stations",
            "format": ",.0f"
          },
          {
            "field": "canoe_stands",
            "type": "quantitative",
            "title": "Canoe stands",
            "format": ",.0f"
          },
          {
            "field": "jetties",
            "type": "quantitative",
            "title": "Jetties",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 152.94,
            "latitude": -27.1,
            "label": "MORETON BAY"
          },
          {
            "longitude": 153.1,
            "latitude": -27.46,
            "label": "Brisbane"
          },
          {
            "longitude": 153.18,
            "latitude": -26.93,
            "label": "Bribie Island"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "color": "#506671",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#f0f7f9"
    },
    "font": "system-ui, sans-serif",
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
